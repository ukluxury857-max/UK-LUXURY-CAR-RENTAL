<style>

/* =========================================================
   UK LUXURY
   PREMIUM AUTOMOTIVE WEBSITE
========================================================= */

:root{
    --black:#070707;
    --black2:#0d0d0d;
    --black3:#141414;
    --white:#f4f2ed;
    --muted:#9c9c9c;
    --gold:#c8a96b;
    --gold-light:#e2c88d;
    --border:rgba(255,255,255,0.10);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--black);
    color:var(--white);
    font-family:"DM Sans",sans-serif;
    overflow-x:hidden;
}

/* =========================================================
   CUSTOM CURSOR
========================================================= */

.cursor{
    width:12px;
    height:12px;
    border:1px solid var(--gold);
    border-radius:50%;
    position:fixed;
    pointer-events:none;
    z-index:9999;
    transform:translate(-50%,-50%);
    transition:
        width .25s ease,
        height .25s ease,
        background .25s ease;
    display:none;
}

@media(min-width:900px){
    .cursor{
        display:block;
    }
}

.cursor.active{
    width:55px;
    height:55px;
    background:rgba(200,169,107,.08);
}

/* =========================================================
   LOADING SCREEN
========================================================= */

.loader{
    position:fixed;
    inset:0;
    background:#050505;
    z-index:10000;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    transition:opacity 1s ease, visibility 1s ease;
}

.loader.hidden{
    opacity:0;
    visibility:hidden;
}

.loader-logo{
    font-family:"Playfair Display",serif;
    font-size:clamp(38px,7vw,90px);
    letter-spacing:.12em;
}

.loader-line{
    width:0;
    height:1px;
    background:var(--gold);
    margin-top:22px;
    animation:loaderLine 1.5s ease forwards;
}

@keyframes loaderLine{
    to{
        width:180px;
    }
}

/* =========================================================
   NAVIGATION
========================================================= */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:85px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 5%;
    z-index:1000;
    transition:.5s ease;
}

nav.scrolled{
    background:rgba(5,5,5,.88);
    backdrop-filter:blur(18px);
    border-bottom:1px solid var(--border);
}

.logo{
    color:white;
    text-decoration:none;
    font-family:"Playfair Display",serif;
    font-size:25px;
    letter-spacing:.16em;
}

.logo span{
    color:var(--gold);
}

.nav-links{
    display:flex;
    align-items:center;
    gap:38px;
}

.nav-links a{
    color:#ddd;
    text-decoration:none;
    font-size:12px;
    letter-spacing:.18em;
    text-transform:uppercase;
    transition:.3s;
}

.nav-links a:hover{
    color:var(--gold);
}

.nav-call{
    border:1px solid rgba(200,169,107,.5);
    padding:12px 19px;
    color:var(--gold)!important;
}

.menu{
    display:none;
    font-size:25px;
    cursor:pointer;
}

/* =========================================================
   HERO
========================================================= */

.hero{
    min-height:100vh;
    position:relative;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
        radial-gradient(circle at 75% 45%,rgba(200,169,107,.10),transparent 28%),
        linear-gradient(120deg,#050505 20%,#111 100%);
}

.hero-bg{
    position:absolute;
    inset:0;
    background:
        linear-gradient(90deg,
        rgba(5,5,5,1) 0%,
        rgba(5,5,5,.92) 35%,
        rgba(5,5,5,.35) 72%,
        rgba(5,5,5,.75) 100%);
    z-index:1;
}

/* Replace this area later with your hero car image */

.hero-car-placeholder{
    position:absolute;
    right:-5%;
    bottom:-8%;
    width:67%;
    height:75%;
    opacity:.23;
    background:
        radial-gradient(ellipse at center,
        rgba(210,210,210,.35),
        transparent 55%);
    filter:blur(1px);
}

.hero-content{
    position:relative;
    z-index:3;
    width:90%;
    max-width:1400px;
    margin:auto;
    padding-top:80px;
}

.hero-small{
    color:var(--gold);
    text-transform:uppercase;
    font-size:12px;
    letter-spacing:.38em;
    margin-bottom:25px;
    opacity:0;
    animation:fadeUp 1s 1.6s forwards;
}

.hero h1{
    font-family:"Playfair Display",serif;
    font-weight:400;
    font-size:clamp(65px,10vw,150px);
    line-height:.85;
    letter-spacing:-.04em;
    max-width:1000px;
    opacity:0;
    animation:fadeUp 1s 1.8s forwards;
}

.hero h1 span{
    color:var(--gold);
    font-style:italic;
}

.hero-description{
    margin-top:35px;
    max-width:490px;
    color:#aaa;
    line-height:1.8;
    font-size:15px;
    opacity:0;
    animation:fadeUp 1s 2s forwards;
}

.hero-buttons{
    display:flex;
    gap:15px;
    margin-top:42px;
    opacity:0;
    animation:fadeUp 1s 2.2s forwards;
}

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:170px;
    padding:16px 25px;
    text-decoration:none;
    text-transform:uppercase;
    letter-spacing:.15em;
    font-size:11px;
    transition:.4s;
}

.btn-gold{
    background:var(--gold);
    color:#080808;
}

.btn-gold:hover{
    background:var(--gold-light);
    transform:translateY(-3px);
}

.btn-outline{
    border:1px solid rgba(255,255,255,.25);
    color:white;
}

.btn-outline:hover{
    border-color:var(--gold);
    color:var(--gold);
    transform:translateY(-3px);
}

.scroll{
    position:absolute;
    bottom:35px;
    left:5%;
    z-index:4;
    display:flex;
    align-items:center;
    gap:15px;
    color:#777;
    font-size:9px;
    letter-spacing:.25em;
    text-transform:uppercase;
}

.scroll-line{
    width:55px;
    height:1px;
    background:#555;
    position:relative;
    overflow:hidden;
}

.scroll-line:after{
    content:"";
    position:absolute;
    left:-100%;
    width:100%;
    height:100%;
    background:var(--gold);
    animation:scrollLine 2s infinite;
}

@keyframes scrollLine{
    to{
        left:100%;
    }
}

/* =========================================================
   INTRO
========================================================= */

.section{
    padding:150px 5%;
    position:relative;
}

.intro{
    background:var(--black);
}

.intro-grid{
    display:grid;
    grid-template-columns:1fr 1.5fr;
    gap:80px;
    max-width:1300px;
    margin:auto;
}

.section-label{
    color:var(--gold);
    font-size:10px;
    letter-spacing:.3em;
    text-transform:uppercase;
}

.intro-title{
    font-family:"Playfair Display",serif;
    font-size:clamp(42px,6vw,85px);
    font-weight:400;
    line-height:1;
}

.intro-title em{
    color:var(--gold);
}

.intro-text{
    color:#999;
    font-size:17px;
    line-height:1.9;
    max-width:650px;
}

.intro-text strong{
    color:#eee;
    font-weight:400;
}

/* =========================================================
   MARQUEE
========================================================= */

.marquee{
    overflow:hidden;
    border-top:1px solid var(--border);
    border-bottom:1px solid var(--border);
    padding:24px 0;
    white-space:nowrap;
    background:#090909;
}

.marquee-track{
    display:inline-block;
    animation:marquee 25s linear infinite;
}

.marquee span{
    font-family:"Playfair Display",serif;
    font-size:27px;
    margin-right:45px;
    color:#aaa;
}

.marquee span.gold{
    color:var(--gold);
}

@keyframes marquee{
    from{
        transform:translateX(0);
    }
    to{
        transform:translateX(-50%);
    }
}

/* =========================================================
   FLEET
========================================================= */

.fleet{
    background:#0b0b0b;
}

.fleet-header{
    max-width:1300px;
    margin:0 auto 75px;
    display:flex;
    justify-content:space-between;
    align-items:end;
}

.fleet-title{
    font-family:"Playfair Display",serif;
    font-size:clamp(45px,7vw,90px);
    font-weight:400;
    line-height:.9;
    margin-top:18px;
}

.fleet-sub{
    max-width:300px;
    color:#888;
    line-height:1.7;
    font-size:13px;
}

.cars{
    max-width:1400px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:30px;
}

.car{
    position:relative;
    min-height:520px;
    background:#121212;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.06);
    transition:.6s ease;
}

.car:hover{
    transform:translateY(-8px);
    border-color:rgba(200,169,107,.35);
}

.car-image{
    position:absolute;
    inset:0;
    height:100%;
    background:
        linear-gradient(180deg,
        transparent 35%,
        rgba(0,0,0,.9) 100%);
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
}

/*
=========================================================
CAR IMAGE PLACEHOLDER

When you have a car image:

1. Upload it to your GitHub repository.
2. Replace the background line below with:

background-image:url('car1.jpg');

Do this for each vehicle.
=========================================================
*/

.car-image:before{
    content:"YOUR CAR PHOTO";
    color:rgba(255,255,255,.08);
    font-size:12px;
    letter-spacing:.35em;
}

.car-number{
    position:absolute;
    top:25px;
    left:27px;
    color:var(--gold);
    font-size:11px;
    letter-spacing:.2em;
}

.car-content{
    position:absolute;
    bottom:0;
    left:0;
    width:100%;
    padding:35px;
    z-index:2;
}

.car-category{
    font-size:9px;
    text-transform:uppercase;
    color:var(--gold);
    letter-spacing:.3em;
    margin-bottom:10px;
}

.car h3{
    font-family:"Playfair Display",serif;
    font-weight:400;
    font-size:42px;
    margin-bottom:20px;
}

.car-info{
    display:flex;
    gap:25px;
    color:#888;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.1em;
    margin-bottom:25px;
}

.car-buttons{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

.car-btn{
    text-decoration:none;
    color:#eee;
    border:1px solid rgba(255,255,255,.2);
    padding:12px 15px;
    font-size:9px;
    letter-spacing:.14em;
    text-transform:uppercase;
    transition:.3s;
}

.car-btn:hover{
    border-color:var(--gold);
    color:var(--gold);
}

.book-btn{
    background:var(--gold);
    color:#080808;
    border-color:var(--gold);
}

.book-btn:hover{
    background:var(--gold-light);
    color:#080808;
}

/* =========================================================
   EXPERIENCE
========================================================= */

.experience{
    background:#050505;
}

.experience-header{
    max-width:1300px;
    margin:auto;
}

.experience-title{
    font-family:"Playfair Display",serif;
    font-size:clamp(45px,7vw,90px);
    font-weight:400;
    margin-top:20px;
}

.experiences{
    max-width:1300px;
    margin:80px auto 0;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    border-top:1px solid var(--border);
}

.experience-card{
    padding:45px 25px;
    border-right:1px solid var(--border);
    transition:.4s;
}

.experience-card:last-child{
    border-right:none;
}

.experience-card:hover{
    background:#101010;
}

.experience-number{
    color:var(--gold);
    font-size:11px;
}

.experience-card h3{
    font-family:"Playfair Display",serif;
    font-size:27px;
    font-weight:400;
    margin:60px 0 18px;
}

.experience-card p{
    color:#777;
    line-height:1.8;
    font-size:13px;
}

/* =========================================================
   ABOUT
========================================================= */

.about{
    background:#0c0c0c;
}

.about-grid{
    max-width:1300px;
    margin:auto;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:100px;
    align-items:center;
}

.about-title{
    font-family:"Playfair Display",serif;
    font-weight:400;
    font-size:clamp(45px,6vw,80px);
    line-height:.95;
    margin-top:20px;
}

.about-title span{
    color:var(--gold);
}

.about-text{
    color:#999;
    line-height:1.9;
    font-size:15px;
}

.about-text p{
    margin-bottom:22px;
}

.about-year{
    margin-top:50px;
    border-top:1px solid var(--border);
    padding-top:25px;
    display:flex;
    justify-content:space-between;
    color:#777;
    font-size:11px;
    letter-spacing:.15em;
}

.about-year strong{
    color:var(--gold);
    font-size:25px;
    font-family:"Playfair Display",serif;
}

/* =========================================================
   BOOKING CTA
========================================================= */

.booking{
    padding:170px 5%;
    text-align:center;
    background:
        radial-gradient(circle at center,
        rgba(200,169,107,.09),
        transparent 45%),
        #070707;
}

.booking .section-label{
    display:block;
}

.booking h2{
    font-family:"Playfair Display",serif;
    font-weight:400;
    font-size:clamp(50px,9vw,125px);
    line-height:.85;
    margin:25px auto 35px;
    max-width:1100px;
}

.booking h2 em{
    color:var(--gold);
}

.booking p{
    color:#888;
    max-width:500px;
    margin:auto;
    line-height:1.8;
}

.booking-buttons{
    margin-top:40px;
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
}

/* =========================================================
   CONTACT
========================================================= */

.contact{
    background:#0d0d0d;
    padding-bottom:100px;
}

.contact-grid{
    max-width:1300px;
    margin:auto;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:100px;
}

.contact-title{
    font-family:"Playfair Display",serif;
    font-size:clamp(45px,6vw,80px);
    font-weight:400;
    line-height:.95;
    margin-top:20px;
}

.contact-title span{
    color:var(--gold);
}

.contact-info{
    display:flex;
    flex-direction:column;
    gap:0;
}

.contact-item{
    padding:25px 0;
    border-bottom:1px solid var(--border);
}

.contact-item small{
    color:var(--gold);
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:.25em;
}

.contact-item a,
.contact-item p{
    display:block;
    color:#ddd;
    text-decoration:none;
    font-size:18px;
    margin-top:8px;
    transition:.3s;
}

.contact-item a:hover{
    color:var(--gold);
}

/* =========================================================
   FOOTER
========================================================= */

footer{
    padding:40px 5%;
    border-top:1px solid var(--border);
    display:flex;
    justify-content:space-between;
    align-items:center;
    color:#555;
    font-size:10px;
    letter-spacing:.12em;
    text-transform:uppercase;
}

.footer-logo{
    font-family:"Playfair Display",serif;
    color:#ddd;
    font-size:20px;
    letter-spacing:.15em;
}

/* =========================================================
   REVEAL ANIMATION
========================================================= */

.reveal{
    opacity:0;
    transform:translateY(40px);
    transition:1s ease;
}

.reveal.visible{
    opacity:1;
    transform:translateY(0);
}

@keyframes fadeUp{
    from{
        opacity:0;
        transform:translateY(30px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* =========================================================
   MOBILE
========================================================= */

@media(max-width:850px){

    nav{
        height:70px;
