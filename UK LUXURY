    }

    .hero-content{
        padding-top:90px;
    }

    .hero h1{
        font-size:17vw;
    }

    .hero-description{
        font-size:13px;
        max-width:330px;
    }

    .hero-buttons{
        flex-direction:column;
        width:220px;
    }

    .btn{
        width:100%;
    }

    .hero-car-placeholder{
        width:100%;
        right:-25%;
        opacity:.18;
    }

    .section{
        padding:95px 6%;
    }

    .intro-grid{
        grid-template-columns:1fr;
        gap:35px;
    }

    .fleet-header{
        display:block;
    }

    .fleet-sub{
        margin-top:25px;
    }

    .cars{
        grid-template-columns:1fr;
        gap:18px;
    }

    .car{
        min-height:470px;
    }

    .car h3{
        font-size:34px;
    }

    .experiences{
        grid-template-columns:1fr 1fr;
    }

    .experience-card{
        border-bottom:1px solid var(--border);
    }

    .experience-card:nth-child(2){
        border-right:none;
    }

    .about-grid{
        grid-template-columns:1fr;
        gap:50px;
    }

    .contact-grid{
        grid-template-columns:1fr;
        gap:50px;
    }

    footer{
        flex-direction:column;
        gap:15px;
        text-align:center;
    }

}

@media(max-width:500px){

    .hero h1{
        font-size:18vw;
    }

    .hero-small{
        font-size:9px;
    }

    .booking h2{
        font-size:17vw;
    }

    .experiences{
        grid-template-columns:1fr;
    }

    .experience-card{
        border-right:none;
    }

    .car{
        min-height:500px;
    }

    .car-content{
        padding:25px;
    }

    .car-info{
        gap:12px;
        flex-wrap:wrap;
    }

}

</style>
</head>

